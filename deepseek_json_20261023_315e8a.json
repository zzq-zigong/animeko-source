{
  "name": "天天动漫 (ttdm7.me)",
  "description": "基于苹果CMS的天天动漫站点，仅适配搜索与条目浏览，剧集与播放需手动补齐。",
  "version": 1,
  "type": "selector",
  "baseUrl": "https://www.ttdm7.me",
  "searchConfig": {
    "searchUrl": "/vod-search/-------------/?wd={keyword}",
    "selectSubjects": {
      "selector": ".module-poster-item, .module-items .module-poster-item",
      "name": {
        "selector": ".module-poster-item-title",
        "type": "text"
      },
      "url": {
        "selector": "a.module-poster-item",
        "type": "attr",
        "attribute": "href"
      }
    }
  },
  "episodeConfig": {
    "selectEpisodes": {
      "channels": {
        "selector": ".module-play-list-content",
        "name": {
          "selector": ".module-play-list-title",
          "type": "text",
          "default": "默认线路"
        },
        "episodes": {
          "selector": ".module-play-list-link",
          "name": {
            "selector": "span",
            "type": "text"
          },
          "url": {
            "selector": "a",
            "type": "attr",
            "attribute": "href"
          }
        }
      }
    }
  },
  "mediaConfig": {
    "matchVideo": {
      "regex": "(https?:)?//[^\"']+\\.(m3u8|mp4)[^\"']*",
      "group": 0
    }
  }
}