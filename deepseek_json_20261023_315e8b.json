{
  "schemaVersion": 2,
  "mediaSources": [
    {
      "factoryId": "web-selector",
      "version": 2,
      "arguments": {
        "name": "天天动漫 (ttdm7.me)",
        "description": "直连；已优化搜索参数，剧集选择器待播放页验证",
        "iconUrl": "https://static.ttfile.top/upload/mxprocms/20241022-1/607e09e081eb551dd290880e1fe29a90.png",
        "searchConfig": {
          "searchUrl": "https://www.ttdm7.me/vod-search/-------------/?wd={keyword}",
          "searchUseOnlyFirstWord": true,
          "searchRemoveSpecial": true,
          "searchUseSubjectNamesCount": 2,
          "rawBaseUrl": "",
          "requestInterval": 3000,
          "searchCacheTtl": 7200000,
          "userAgent": "",
          "subjectFormatId": "indexed",
          "selectorSubjectFormatIndexed": {
            "selectNames": ".module-poster-item-title",
            "selectLinks": "a.module-poster-item",
            "linkTemplate": null,
            "preferShorterName": true
          },
          "channelFormatId": "index-grouped",
          "selectorChannelFormatFlattened": {
            "selectChannelNames": ".module-tab-item",
            "matchChannelName": "^(?<ch>.+?)(\\d+)?$",
            "selectEpisodeLists": ".module-play-list-content",
            "selectEpisodesFromList": "a",
            "selectEpisodeLinksFromList": "",
            "matchEpisodeSortFromName": "第\\s*(?<ep>.+)\\s*[话集]"
          },
          "selectorChannelFormatNoChannel": {
            "selectEpisodes": ".module-play-list-link, .module-play-list-content a",
            "selectEpisodeLinks": "",
            "matchEpisodeSortFromName": "(第\\s*(?<ep>.+)\\s*[话集])|(^\\s*(?<ep>\\d+)\\s*$)"
          },
          "defaultResolution": "1080P",
          "defaultSubtitleLanguage": "CHS",
          "onlySupportsPlayers": [],
          "filterByEpisodeSort": false,
          "selectMedia": {
            "distinguishSubjectName": true,
            "distinguishChannelName": false
          },
          "matchVideo": {
            "enableNestedUrl": true,
            "matchNestedUrl": "$^",
            "matchVideoUrl": "(^http(s)?://(?!.*http(s)?://).+(\\.m3u8).*(\\?.+)?)",
            "cookies": "",
            "addHeadersToVideo": {
              "referer": "https://www.ttdm7.me/"
            }
          },
          "autoMatch": {
            "enabled": true,
            "searchUseOnlyFirstWord": true,
            "searchRemoveSpecial": true,
            "searchUseSubjectNamesCount": 2,
            "preferShorterName": true,
            "filterByEpisodeSort": false
          }
        }
      },
      "tier": 1,
      "channelTiers": {}
    }
  ]
}